# Supabase (public — safe for client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Telegram Bot (server-only — never expose to client)
TELEGRAM_BOT_TOKEN=

# App URL (set after first Vercel deploy)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upstash Redis (server-only) — distributed rate limiting across serverless
# instances. Required in production; without these, rate limiting is
# disabled and a console.error is logged on cold start. See lib/rate-limit.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
